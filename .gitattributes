# 强制 LF 行尾，避免 Windows 协作时的 CRLF 污染
*               text=auto eol=lf
*.go            text eol=lf
*.md            text eol=lf
*.toml          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.sh            text eol=lf
*.mod           text eol=lf
*.sum           text eol=lf
*.bat           text eol=lf
Dockerfile      text eol=lf
LICENSE         text eol=lf
